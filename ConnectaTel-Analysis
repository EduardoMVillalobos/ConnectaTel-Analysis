    "    if age < 30:\n",
    "        return 'Joven'\n",
    "    elif age < 60:\n",
    "        return 'Adulto'\n",
    "    else:\n",
    "        return 'Adulto Mayor'\n",
    "\n",
    "user_profile['grupo_edad'] = user_profile.apply(clasif_edad, axis = 1)\n",
    "print(user_profile['grupo_edad'].value_counts())"
